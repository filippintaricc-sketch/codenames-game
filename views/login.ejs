<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel = "stylesheet" href = "/css/login.css">
    <title>Login</title>
  </head>
  <body>
    <div class="container">
      <%if(error){%>
       <p class="error"><%=error%></p>
      <%}%>
      <form method="POST" action="/login">
        <label for="name">Unesite svoje ime</label><br>
        <input type="text" id="name" name="name" required /><br>
        <button type="submit" class = "submit-btn">Unesi</button>
      </form>
    </div>
  </body>
</html>
