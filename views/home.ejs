<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Codenames</title>
    <link rel = "stylesheet" href = "/css/home.css">
</head>
<body>
    <h1>Dobrodosli u codenames!</h1>
    <h2>Odaberite tim i ulogu</h2>
    <hr>
    <%if (host){%>
    <form method = "POST" action = "/home/setTimer" class = "timer-form">
        <span class = "timer-title">⏱ Tajmer</span>
        <div class = "timer-options">
            <%[
                {value: 90, name: "brzo", time: "1:30"},
                {value: 150, name: "normalno", time: "2:30"},
                {value: 300, name: "opušteno", time: "5:00"},
                {value: 0, name: "bez", time: ""}
            ].forEach(opt=>{%>
            <label>
                <input type = "radio" name = "timer" value = "<%=opt.value%>" required <%=timer === opt.value ? "checked" : ""%>>
                <span><%=opt.name%><%if(opt.time){%> <small><%=opt.time%></small><%}%></span>
            </label>
            <%})%>
        </div>
        <button type = "submit" class = "enter-btn timer-btn">Postavi</button>
        <%if(timer === undefined){%>
        <p class = "timer-hint">Odaberite tajmer prije početka igre</p>
        <%}%>
    </form>
    <%}%>
    <div class = "container">
        
        <%teams.forEach(elem=>{%>
        <div class = "kartica">
                <div class ="teamName <%=elem.team%>"><%=elem.team%> tim <%=elem.type%></div>
                <ul>
                <% elem.players.forEach(el=>{%>
                    <li><%=el%></li>
                <%})%>
                </ul>
                <form method = "POST" action = "/home/teamEnter">
                    <input type ="hidden" value = "<%=elem.id%>" name = "team">
                    <button type ="submit" class ="enter-btn">Udi ovdje</button>
                </form>
        </div>
        <%})%>
    </div>
    <%if (host){%>
    <button  onclick =  "window.location.href = '/home/startGame'" class = "enter-btn">Zapocni igru!</button>
    <%}%>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        socket.on("game-update", () => location.reload());
    </script>
</body>
</html>