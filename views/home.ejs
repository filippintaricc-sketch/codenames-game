<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Codenames</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/table.css">
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>
    <header class="bar">
        <span class="wordmark disp">Codenames</span>
        <span><%= me %><%= host ? " · domaćin" : "" %></span>
    </header>

    <main class="table">
        <section class="invite paper">
            <h1 class="disp">Codenames</h1>
            <p class="sub">Dvije ekipe, četiri uloge. Odaberite mjesto za stolom; igra kreće kad je svaka uloga zauzeta.</p>

            <div class="seats">
                <% ["Plavi", "Crveni"].forEach(teamName => { %>
                <div class="team-<%= teamName %>">
                    <h2 class="disp"><%= teamName %></h2>
                    <%# Spymasters first, then operatives %>
                    <% teams.filter(t => t.team === teamName)
                            .sort((a, b) => a.type === "špijuni" ? -1 : 1)
                            .forEach(role => { %>
                    <div class="seat">
                        <h3><%= role.type === "špijuni" ? "Špijuni" : "Operativci" %></h3>
                        <p>
                            <% if (role.players.length) { %>
                                <% role.players.forEach((name, i) => { %><%= i ? ", " : "" %><span class="<%= name === me ? "me" : "" %>"><%= name %></span><% }) %>
                            <% } else { %>
                                <span class="empty">Prazno mjesto</span>
                            <% } %>
                        </p>
                        <% if (!role.players.includes(me)) { %>
                        <form method="POST" action="/home/teamEnter">
                            <input type="hidden" name="team" value="<%= role.id %>">
                            <button type="submit" class="btn-ink">Sjedni</button>
                        </form>
                        <% } %>
                    </div>
                    <% }) %>
                </div>
                <% }) %>
            </div>
        </section>

        <% if (host) { %>
        <form method="POST" action="/home/setTimer" class="stub paper">
            <h2 class="disp">Vrijeme za potez</h2>
            <div class="timer-options">
                <% [
                    {value: 90, time: "1:30", name: "brzo"},
                    {value: 150, time: "2:30", name: "normalno"},
                    {value: 300, time: "5:00", name: "opušteno"},
                    {value: 0, time: "bez", name: "bez tajmera"}
                ].forEach(opt => { %>
                <label>
                    <input type="radio" name="timer" value="<%= opt.value %>" required <%= timer === opt.value ? "checked" : "" %>>
                    <b><%= opt.time %></b><%= opt.name %>
                </label>
                <% }) %>
            </div>
            <div class="timer-row">
                <button type="submit" class="btn-ink">Postavi vrijeme</button>
                <% if (timer === undefined) { %>
                <p>Vrijeme još nije postavljeno.</p>
                <% } %>
            </div>
        </form>

        <div class="go">
            <form method="GET" action="/home/startGame">
                <button type="submit" class="btn-main" <%= missing.length || timer === undefined ? "disabled" : "" %>>Podijeli karte</button>
            </form>
            <p>
                <% if (missing.length) { %>
                    Još je prazno: <%= missing.join(", ") %>.
                <% } else if (timer === undefined) { %>
                    Postavite vrijeme za potez.
                <% } else { %>
                    Svi su za stolom.
                <% } %>
            </p>
        </div>
        <% } else { %>
        <div class="go">
            <p>Domaćin dijeli karte kad je svaka uloga zauzeta.</p>
        </div>
        <% } %>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        socket.on("game-update", () => location.reload());
    </script>
</body>
</html>
